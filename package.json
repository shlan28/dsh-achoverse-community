{
  "name": "dsh-achoverse-community",
  "version": "0.1.0",
  "description": "Achoverse 社区 DSH 插件：左侧栏入口 + 板块/帖子/评论面板，并让 agent 通过 community 工具读写社区。",
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "src",
    "dist/client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/index.md",
    "docs/install.md",
    "docs/images/community-preview.png"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "community",
    "achoverse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlan28/dsh-achoverse-community.git"
  },
  "homepage": "https://github.com/shlan28/dsh-achoverse-community#readme",
  "bugs": {
    "url": "https://github.com/shlan28/dsh-achoverse-community/issues"
  }
}
